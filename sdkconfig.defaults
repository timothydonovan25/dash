CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: N16R8 is octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Lets EXT_RAM_BSS_ATTR put the map traces and the blackbox in PSRAM, which
# keeps internal SRAM for the panel's DMA buffer and the task stacks.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# BLE — see docs/system-architecture.md section 11.4.
# Both of these MUST stay on core 1 or the shift-light latency budget breaks.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Peripheral: the phone connects in and writes the media Feed
# characteristic. Observer: passive scan for TPMS beacons, which never
# connect. Central and the GATT client existed only for Apple's AMS, which
# section 11.1 is explicitly not doing -- the phone here is an Android
# handset. They are off because they are not free: NimBLE and the
# controller add about 268 kB of image as configured.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE=1
CONFIG_BT_CTRL_PINNED_TO_CORE=1
