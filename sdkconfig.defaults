CONFIG_IDF_TARGET="esp32p4"

# The P4 board: Guition JC-ESP32P4-M3-C6 module. docs/p4-board-pin-map.md.
#
# BRINGUP: chip revision. The only P4 measured so far (demo_p4's board) was
# revision v1.3, which needs the pre-v3 selection below; v3.x silicon is a
# different hardware family in IDF's own words. Read the module's revision
# with `esptool.py chip-id` on arrival and change these two lines if it is
# v3 or later.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Stable and dev firmware in the two app slots (system-architecture §11.7).
# Rollback is what makes dev one-shot: a dev image never confirms itself, so
# the bootloader returns to stable on the next reset. The bootloader cannot
# be updated over the air, so this has to be in the first image ever flashed.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Boot speed: a power-on does not hash the whole 1.1 MB image first, which
# is most of the bootloader's time. The trade: a stable image corrupted in
# flash is not caught, so there is no automatic fallback for it -- USB
# reflash is the recovery. Every software restart still validates, so a dev
# image booted from DIAG -> Update is checked before it runs, and an install
# is hashed by esp_ota_end() before it is ever bootable.
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y

# PSRAM: 32 MB in the P4NRW32's own package, hex mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# Lets EXT_RAM_BSS_ATTR put the map traces and the blackbox in PSRAM, which
# keeps internal SRAM for the panel's staging buffer and the task stacks.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# No pattern test of all 32 MB at every boot: it is the largest single cost
# between power and the first frame. Turn it back on for bring-up if PSRAM
# is suspect (bringup.md).
CONFIG_SPIRAM_MEMTEST=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# The console. The USB-C connector is wired to the full-speed USB-Serial/JTAG
# port on GPIO24/25, so one cable flashes, monitors and debugs. UART0 on
# GPIO37/38 stays on test pads as a fallback for when USB is wedged.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE (§11). The P4 has no radio: NimBLE runs here as the host and the
# controller runs on the module's ESP32-C6, reached over SDIO through
# esp_hosted's VHCI transport. demo_p4/sdkconfig.defaults is where every line
# of the esp_hosted block was found the hard way; do not trust its choice
# defaults, which picked SPI and an ESP32-H2 when the top-level gate was off.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# The module's internal P4-to-C6 wiring, not this board's: CLK 18, CMD 19,
# D0-D3 14-17, C6 reset on GPIO54 active high. These pins never reach
# pins.hpp because nothing on the PCB touches them.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
# Off core 0 (§11.4). main.cpp fails the build if this is ever lost.
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
# Peripheral only. No central or GATT client (they were only for AMS,
# §11.3). Observer comes back with the TPMS scan.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
# One phone. `ble` tracks a single connection for Ctrl.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# §11.1: a 60-byte title fits one write, no chunking.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# Bonds survive a power cycle, so the phone reconnects every ride.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
