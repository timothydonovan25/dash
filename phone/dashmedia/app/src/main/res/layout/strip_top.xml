<?xml version="1.0" encoding="utf-8"?>
<!-- The dash link, on every screen. It is the one piece of state that matters
     while riding, and a status you have to go looking for is a status you
     find out about too late. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/strip"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/strip_link"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="10sp"
        android:textColor="@color/dim" />

    <TextView
        android:id="@+id/strip_scope"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/accent" />
</LinearLayout>
