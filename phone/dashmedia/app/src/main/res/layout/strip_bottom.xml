<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing on this phone is discoverable by looking at it, so the three keys
     say what they do. Middle doubles as the repeat-scope readout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/strip"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/soft_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start"
        android:paddingStart="4dp"
        android:singleLine="true"
        android:textSize="10sp"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/soft_middle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:singleLine="true"
        android:textSize="10sp"
        android:textColor="@color/text" />

    <TextView
        android:id="@+id/soft_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:textSize="10sp"
        android:textColor="@color/text" />
</LinearLayout>
