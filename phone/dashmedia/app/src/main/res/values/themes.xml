<resources>
    <style name="Theme.DashMedia" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- 240x320 means about seven rows a screen. Anything smaller than this
         is unreadable at arm's length in daylight. -->
    <style name="Row.Title" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
    </style>

    <style name="Row.Sub" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
