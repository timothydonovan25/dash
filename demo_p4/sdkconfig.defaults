CONFIG_IDF_TARGET="esp32p4"

# The real board is early silicon (chip revision v1.3, confirmed by
# esptool at flash time), not the v3.x IDF defaults to. v3.x and pre-v3.x
# ESP32-P4 revisions are mutually exclusive hardware families in IDF's own
# words (see components/esp_hw_support/port/esp32p4/Kconfig.hw_support),
# so this is a real fact about the board, not a tunable.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# The real dash's partition table and boot settings, not a demo's own, so
# the stable/dev slots, rollback and boot time are tested on this board
# exactly as they will run on the real one (system-architecture §11.7).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# The listing advertises 32MB PSRAM / 16MB flash for this board family; both
# knobs are here to change once the actual module is confirmed.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# No CAN, no SD in this build — see demo_p4/README.md.

# BLE, over the ESP32-C6 co-processor: the P4 itself has no radio, so
# NimBLE runs here as the "host" and the actual controller runs on the C6,
# reached over SDIO via ESP-Hosted's VHCI transport. See ble_media.cpp,
# demo_p4/c6_cp/ (the C6's own firmware), and docs/bringup-p4-demo.md.
#
# The top-level gate (a plain menuconfig bool, off by default). The whole
# "ESP-Hosted config" submenu below — interface, SDIO pins, CP target —
# depends on this and silently no-ops without it, which cost real time to
# track down: leaving it unset produced a build that compiled clean but
# had picked SPI and an ESP32-H2 coprocessor target, neither of which
# exist on this board, entirely by un-gated choice defaults.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# SDIO buffers in PSRAM (the P4's DMA reaches it through the cache). In
# internal RAM they are ~87 kB taken by a constructor before the scheduler
# starts, when internal heap is only _heap_start..0x4FF3AFC0 plus 18 kB,
# and the demo boot-looped for lack of 1.5 kB for an idle task.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Everything below is explicit rather than left to defaults, after the
# above experience — the choice defaults in this component don't reliably
# favor this board's actual chips. CLK18/CMD19/D0-3=14/15/16/17, C6
# reset=GPIO54 active-HIGH: confirmed against this exact board's published
# field notes (docs/bringup-p4-demo.md), and they also happen to be this
# component's own generic-ESP32P4 SDIO defaults once slot 1 is selected —
# but selected explicitly, not trusted to fall out of a choice default.
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# The _PRIV_..._SLOT_1 names are the ones with an actual prompt (settable);
# ESP_HOSTED_SDIO_PIN_CLK/CMD/D0/D1/D2/D3 are computed-only aliases that
# just read whichever slot's PRIV value applies, and assigning them
# directly would be silently overridden by that computation.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# NimBLE host stack; no local controller (the C6 supplies it).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# The rest of the real dash's NimBLE block: ble_service.cpp runs here.
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
# SC pairing failed DHKey check (SM error 0x0B) with the TinyCrypt backend
# against Android; mbedTLS computes it correctly.
CONFIG_BT_NIMBLE_CRYPTO_STACK_MBEDTLS=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# No core dump checksum at boot. With a dump in flash, IDF verifies it with
# the SHA engine during startup and leaves that engine clock-gated and held
# in reset; a reset in that state (a brownout while cranking, a flash from a
# laptop) left the ESP32-P4 v1.x ROM unable to boot until power was removed.
# Found on the demo board: it began the moment the first crash saved a dump.
# The dump is still written on a crash and checked by `idf.py coredump-info`;
# skipping the check also takes ~35 ms off the boot. components/p4_restart_fix
# covers the panic path, which writes the dump with SHA just before restarting.
CONFIG_ESP_COREDUMP_CHECK_BOOT=n

# Not CONFIG_SPIRAM_XIP_FROM_PSRAM, though IDF's LCD docs suggest it for the
# panel flickering during OTA uploads (flash writes suspend the PSRAM cache
# the DSI frame buffer is scanned from). Tried in 1.1: the image asserted at
# startup creating the main task (app_startup.c:83) and fell back to stable.
# The flicker is cosmetic, demo-only and upload-only; the bike's i80 panel
# keeps its own GRAM.

# Per-task stack high-water marks for DIAG -> System (services::watch_stacks).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
