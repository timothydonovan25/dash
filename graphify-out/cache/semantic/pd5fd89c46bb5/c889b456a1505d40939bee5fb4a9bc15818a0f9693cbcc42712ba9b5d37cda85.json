{"nodes": [{"id": "docs_system_architecture", "label": "Dashboard V2 System Architecture", "file_type": "document", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_five_design_rules", "label": "Five design rules", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No globals, one writer per state, core/ has no ESP headers, screen is pure function of Frame, drivers report health not policy; replaces v1's globals.h with 60 externs"}, {"id": "docs_system_architecture_published_t", "label": "Published<T> publish slot", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One writer, many readers, no mutex; seqlock with for(;;) retry because do/while returned torn values ~1 in a million"}, {"id": "docs_system_architecture_frame", "label": "Frame snapshot", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render reads every slot once per frame; screens receive const Frame& and cannot reach hardware"}, {"id": "docs_system_architecture_trackbuffer", "label": "TrackBuffer ring for bulk data", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids 2.4 kB memcpy per publish and v1's bulkRev counter"}, {"id": "docs_system_architecture_command_queue", "label": "Command queue (UI posts commands)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI never writes state; one queue, one drain point, easy to log"}, {"id": "docs_system_architecture_layer_model", "label": "Layered architecture (bsp/drivers/core/services/state/ui/app)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data moves up, commands move down, no layer skips a layer"}, {"id": "docs_system_architecture_task_table", "label": "Task table and core split", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core 0 is a real-time island (ctrl, imu, gnss, logic, input); core 1 takes everything that can be late"}, {"id": "docs_system_architecture_tach_to_lamp_budget", "label": "3 ms tach-edge-to-shift-lamp latency budget", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPIO edge -> ctrl at 500 Hz -> one PCA9955B I2C write ~100 us; ctrl priority 18 above everything on core 0"}, {"id": "docs_system_architecture_bus_ownership", "label": "Bus ownership (SPI2, i80, I2C0, I2C1, UART1)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never call spi_device_acquire_bus(); IDF serialises per transaction; separate I2C1 so a crushed pod cable cannot take lamps"}, {"id": "docs_system_architecture_boot_order", "label": "Boot order", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backlight is PCA9955B channels so LED driver must answer before backlight; show boot screen before sensors"}, {"id": "docs_system_architecture_modes_and_screens", "label": "Modes, screens and five-button navigation (core/nav)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_screen_interface", "label": "Screen interface (update sets widget values only)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_widget_dirty_model", "label": "Retained-mode widgets with dirty flags", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "set() compares to last value and touches only on change; widget is the unit of redraw"}, {"id": "docs_system_architecture_ili9488_8080_rgb565", "label": "ILI9488 on 8-bit 8080 bus, RGB565", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over SPI the ILI9488 needs RGB666 (3 B/px); on 8080 RGB565 works; 307 kB frame ~31 ms at 10 MHz so draw in bands and send only what changed"}, {"id": "docs_system_architecture_lean_from_v_omega", "label": "Lean from v * yaw rate (not accelerometer)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accelerometer reads 'down' in a steady turn; lean = atan(v*omega_yaw/g) as slow correction to gyro"}, {"id": "docs_system_architecture_no_compass_heading", "label": "No compass heading (ICM-42688-P has no magnetometer)", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "6-axis part; magnetometer on a steel frame near ignition would calibrate poorly; use GPS course"}, {"id": "docs_system_architecture_jump_detection", "label": "Jump detection by free fall", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_storage_data_kinds", "label": "Storage: NVS life/cfg namespaces and SD", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_blackbox_logger_csv", "label": "Blackbox logger: PSRAM ring to SD, RaceRender CSV", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSV not binary: a blackbox you need a tool to read is never read; 13 MB/hour is not a constraint"}, {"id": "docs_system_architecture_usb_mass_storage_owner", "label": "USB mass storage owner state machine (BIKE/HOST)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESP and PC cannot both mount the card; VBUS alone is not a trigger because USB and bike are diode-OR'd"}, {"id": "docs_system_architecture_iengine", "label": "IEngine interface (NullEngine, UartEngine, CanEngine, BleEngine)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swapping transport changes nothing above IEngine"}, {"id": "docs_system_architecture_dash_cannot_receive_can", "label": "Dash cannot receive CAN (no transceiver)", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TWAI is logic-level only; NullEngine wired in"}, {"id": "docs_system_architecture_fuel_model", "label": "Fuel used model (estimate)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_dash_media_gatt", "label": "Dash Media GATT service (Feed characteristic, tag lines)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Bluetooth Classic on C6 so no AVRCP/SPP; GATT chosen over L2CAP CoC so nRF Connect can poke it"}, {"id": "docs_system_architecture_notification_tag_n", "label": "Notification tag N (calls, messages)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_tpms_beacon_decoders", "label": "TPMS advertisement decoders (observer scan)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TPMS sensors are advertising-only beacons; decode problem, not Bluetooth problem; not built yet"}, {"id": "docs_system_architecture_ble_pairing_policy", "label": "BLE pairing policy (first bond free, pairing window)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android rotates addresses; only bond identity recognises the phone"}, {"id": "docs_system_architecture_radio_task_placement", "label": "NimBLE on core 1, ESP-Hosted tasks lowered to priority 8", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESP-Hosted creates SDIO/RPC tasks at prio 23 with no affinity; could preempt ctrl on core 0"}, {"id": "docs_system_architecture_no_apple_ams", "label": "Not doing Apple AMS", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs GATT client + central, second connection path for a phone nobody carries"}, {"id": "docs_system_architecture_partition_table_0x10000", "label": "Partition table at 0x10000", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bootloader is never updated OTA; at 0x8000 it had 1.1 kB spare, at 0x10000 33 kB"}, {"id": "docs_system_architecture_stable_dev_firmware_slots", "label": "Stable and dev firmware slots (rollback)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Which is which is read from bootloader rollback state, never stored; dev never confirms itself so any reset returns to stable"}, {"id": "docs_system_architecture_no_secure_boot", "label": "Secure boot and flash encryption off", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Burn eFuses and would end USB recovery and dev-slot uploads"}, {"id": "docs_system_architecture_wifi_update_hotspot", "label": "Wi-Fi update hotspot (never a station)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works at a track without a router, stores no passwords; ota stays the one writer of dev slot; nothing on network can boot"}, {"id": "docs_system_architecture_health_devstate", "label": "Health and DevState fault model", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never stop: mark device dead and keep running; keeper retries Fault every 5 s; dead data shows -- not stale zero"}, {"id": "docs_system_architecture_configitem_table", "label": "ConfigItem table", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a setting is one line; key stable forever so old NVS loads"}, {"id": "docs_system_architecture_host_tests", "label": "Host tests (plain CMake, check.hpp)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strongest reason to keep core/ free of ESP headers"}, {"id": "docs_system_architecture_v1_to_v2_differences", "label": "Differences from V1", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_build_order", "label": "Build order (steps 1-10)", "file_type": "concept", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_system_architecture_dash_hal_naming", "label": "hal/ renamed dash_hal/", "file_type": "rationale", "source_file": "docs/system-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ESP-IDF has its own component 'hal'; project component won and broke espcoredump"}], "edges": [{"source": "docs_system_architecture", "target": "docs_p4_board_pin_map", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_architecture", "target": "docs_p4_platform_selection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_architecture", "target": "docs_bringup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_architecture_five_design_rules", "target": "docs_system_architecture_published_t", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_architecture_five_design_rules", "target": "docs_system_architecture_frame", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_architecture_five_design_rules", "target": "docs_system_architecture_host_tests", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system-architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_system_architecture", "target": "docs_system_architecture_five_design_rules", "relation": "references